# Porta e host do servidor (use 0.0.0.0 apenas em container/rede confiável)
PORT=3737
HOST=127.0.0.1
# Pasta de dados (SQLite + chave gerada)
DATA_DIR=./data
# Segredo usado para cifrar chaves de API (AES-256-GCM). Se vazio, é gerado em DATA_DIR/secret.key
THINKFLOW_SECRET=
# Nível de log: fatal | error | warn | info | debug
LOG_LEVEL=info
# Marque true se servir atrás de HTTPS
COOKIE_SECURE=false
# URL do sidecar Presidio (docker compose --profile privacy); vazio = só detectores nativos
PRIVACY_PRESIDIO_URL=
# Folder with the built dashboard (index.html). Default: ../web/dist, then ./public (the Docker image sets /app/public)
# WEB_DIR=
# Folder with the SQL migrations (drizzle). Default: the one bundled with the server (the Docker image sets /app/drizzle)
# MIGRATIONS_DIR=
# Only for `pnpm dev`: where the Vite dev server (port 5173) proxies /api and /v1. Default: http://127.0.0.1:3737
# THINKFLOW_API=http://127.0.0.1:3737

# ---- Armazenamento de documentos (relatórios) ----
# Driver: local (padrão; arquivos em STORAGE_LOCAL_DIR) ou s3 (MinIO / AWS S3 / compatível)
STORAGE_DRIVER=local
# Pasta do driver local (padrão: DATA_DIR/objects)
# STORAGE_LOCAL_DIR=./data/objects
# Prefixo opcional das chaves, para dividir um bucket entre ambientes (ex.: thinkflow/)
# STORAGE_PREFIX=
# Tamanho máximo de um objeto, em MB (1 a 1024)
# STORAGE_MAX_OBJECT_MB=100

# --- S3 (usado só com STORAGE_DRIVER=s3) ---
# Endpoint (obrigatório para MinIO). No compose use http://minio:9000; no host (pnpm dev) http://127.0.0.1:9000
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=thinkflow
# Usuário da aplicação (NÃO use o root). Alternativa: S3_ACCESS_KEY_ID_FILE / S3_SECRET_ACCESS_KEY_FILE (Docker secrets)
# S3_ACCESS_KEY_ID=thinkflow
# S3_SECRET_ACCESS_KEY=troque-por-um-segredo-longo
# S3_FORCE_PATH_STYLE=true
# Criptografia no servidor: vazio, AES256 ou aws:kms (no MinIO exige KMS/KES)
# S3_SSE=
# S3_SSE_KMS_KEY_ID=
# Se true, a aplicação cria o bucket ao iniciar (alternativa ao minio-init)
# S3_CREATE_BUCKET=false
# S3_TIMEOUT_MS=30000
# S3_CONNECT_TIMEOUT_MS=3000
# S3_MAX_ATTEMPTS=3

# --- MinIO via docker compose (perfil "minio"; ver deploy/minio/README.md) ---
# Ative com: COMPOSE_PROFILES=minio  (ou docker compose --profile minio up -d)
# COMPOSE_PROFILES=minio
# Credenciais root: usadas só pelo minio e pelo minio-init, nunca pela aplicação
# MINIO_ROOT_USER=thinkflow-admin
# MINIO_ROOT_PASSWORD=troque-por-uma-senha-longa
# Imagens (padrão: Chainguard fixadas por digest no docker-compose.yml)
# MINIO_IMAGE=
# MC_IMAGE=
