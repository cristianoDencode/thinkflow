{
  "name": "@thinkflow/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "build": "tsup && node scripts/copy-vendor.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "storage:migrate": "node --env-file-if-exists=../../.env --import tsx src/cli/storage-migrate.ts"
  },
  "//": "playwright-core must stay EXACTLY equal to @playwright/test in apps/web, so it reuses the same Chromium revision in ~/.cache/ms-playwright.",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@thinkflow/shared": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "docx": "^9.15.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pino": "^10.4.0",
    "playwright-core": "1.65.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tesseract.js": "^7.0.0",
    "unified": "^11.0.5",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "jszip": "^3.10.2",
    "mermaid": "^12.3.0",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.1.1"
  }
}
